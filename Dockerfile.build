# ========================================================================
# Cross-Platform Docker Build for BifroMQ (linux/amd64 + linux/arm64)
# ========================================================================
#
# Multi-stage design:
#   Stage 1 (native-builder): Compile Rust + RocksDB C++ native code
#   Stage 2 (java-builder):   Compile Java, package release tarball
#   Stage 3 (runtime):       Minimal JRE image for k8s deployment
#
# Optimizations:
#   - Rust and RocksDB are built once per platform in Stage 1
#   - Maven .m2 cache is mounted from CI for dependency resolution
#   - Dependency resolution and compilation are in separate RUN layers
# ========================================================================

# =============================================================================
# Stage 1: Native Build (Rust + RocksDB JNI)
# =============================================================================
FROM rust:1.83-slim-bookworm AS native-builder

WORKDIR /build

# Install OpenJDK 25 and build tools in a single layer
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget gnupg curl \
    && wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print$2}' /etc/os-release) main" > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        temurin-25-jdk \
        build-essential \
        make \
        cmake \
        pkg-config \
        liblz4-dev \
        libsnappy-dev \
        libzstd-dev \
        libbz2-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# --- Build RocksDB JNI ---
COPY third-party/rocksdb/ /build/third-party/rocksdb/
RUN export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which javac)))) \
    && cd /build/third-party/rocksdb \
    && rm -f make_config.mk \
    && make clean 2>/dev/null || true \
    && make -j$(nproc) rocksdbjava \
        DISABLE_WARNING_AS_ERROR=1

# --- Build BifroMQ Rust native ---
COPY bifromq-native/ /build/bifromq-native/
RUN cd /build/bifromq-native \
    && cargo build --release

# =============================================================================
# Stage 2: Java Build
# =============================================================================
FROM maven:4.0.0-rc-5-eclipse-temurin-25 AS java-builder

WORKDIR /build

ARG TARGETARCH

# Optional: copy local Maven cache (populated by CI) to speed up dependency resolution
COPY m2-cache /root/.m2

# Copy full project source
COPY . /build

# --- Inject native artifacts from Stage 1 ---
# Rust native library
COPY --from=native-builder \
    /build/bifromq-native/target/release/libbifromq_native.so \
    /tmp/libbifromq_native.so
RUN nativeDir="linux-x86_64"; \
    [ "$TARGETARCH" = "arm64" ] && nativeDir="linux-aarch_64"; \
    mkdir -p "/build/bifromq-native-binding/src/main/resources/native/${nativeDir}" \
    && cp /tmp/libbifromq_native.so \
        "/build/bifromq-native-binding/src/main/resources/native/${nativeDir}/libbifromq_native.so"

# RocksDB JNI .so and jar
COPY --from=native-builder \
    /build/third-party/rocksdb/java/target/ /tmp/rocksdb-java-target/
RUN rocksdbSo="librocksdbjni-linux64.so"; \
    [ "$TARGETARCH" = "arm64" ] && rocksdbSo="librocksdbjni-linux-aarch64.so"; \
    mkdir -p "/build/third-party/rocksdb/java/target" \
    && cp "/tmp/rocksdb-java-target/${rocksdbSo}" \
        "/build/third-party/rocksdb/java/target/"

# Install RocksDB JNI jar to local Maven repo
RUN mvn install:install-file \
    -Dfile=/tmp/rocksdbjni.jar \
    -DgroupId=org.rocksdb \
    -DartifactId=rocksdbjni \
    -Dversion=11.2.0 \
    -Dpackaging=jar \
    --no-transfer-progress

# --- Build the full project ---
ENV MAVEN_CONFIG=""
ENV MAVEN_OPTS=""
RUN ./mvnw clean verify -DskipTests \
        -Drat.skip=true \
        -Dcheckstyle.skip=true \
        --no-transfer-progress \
        -Pbuild-release \
    && tar xzf target/output/apache-bifromq-4.0.0-incubating.tar.gz -C /opt

# =============================================================================
# Stage 3: Runtime
# =============================================================================
FROM eclipse-temurin:25-jre

ENV BIFROMQ_HOME=/bifromq

COPY --from=java-builder /opt/apache-bifromq-4.0.0-incubating ${BIFROMQ_HOME}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssl \
        libsnappy1v5 \
        liblz4-1 \
        libzstd1 \
        libbz2-1.0 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p ${BIFROMQ_HOME}/conf/certs \
    && openssl req -x509 -newkey rsa:2048 \
        -keyout ${BIFROMQ_HOME}/conf/certs/server.key \
        -out ${BIFROMQ_HOME}/conf/certs/server.crt \
        -days 365 -nodes \
        -subj "/CN=bifromq" \
    && cat > ${BIFROMQ_HOME}/conf/standalone.yml <<'EOF'
metricsTags:
  env: docker

mqttServiceConfig:
  server:
    tcpListener:
      port: 1883
    quicListener:
      enable: true
      port: 1884
      sslConfig:
        certFile: "conf/certs/server.crt"
        keyFile: "conf/certs/server.key"
        clientAuth: "NONE"

clusterConfig:
  env: "docker"
EOF

WORKDIR ${BIFROMQ_HOME}

EXPOSE 1883
EXPOSE 14567/udp
EXPOSE 1884
EXPOSE 8080

CMD ["/bin/bash", "-c", "${BIFROMQ_HOME}/bin/standalone.sh start && tail -f --retry ${BIFROMQ_HOME}/logs/info.log"]