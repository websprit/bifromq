# maven ignore
target/
output/
# *.jar
*.war
*.zip
*.tar
*.tar.gz
.flattened-pom.xml
tree.txt

# eclipse ignore
.settings/
.project
.classpath

# idea ignore
.idea/
.run/
*.ipr
*.iml
